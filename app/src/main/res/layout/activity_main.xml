<?xml version="1.0" encoding="utf-8"?>
<!--
  CameraGate main screen, built to UI_DESIGN_GUIDE.md:
  pure black bg, card surfaces (#0A0A0A, 12dp radius, 1px borders),
  uppercase labels, monospace for all raw data, screen padding 24/32.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- ============================== header ============================== -->
        <TextView
            style="@style/AppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title" />

        <TextView
            style="@style/StatusLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="@string/app_subtitle" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="32dp"
            android:background="@color/divider" />

        <!-- ============================== server ============================== -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/sec_server" />

        <LinearLayout
            style="@style/Card"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <TextView
                style="@style/StatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_status" />

            <TextView
                android:id="@+id/status"
                style="@style/BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ============================== camera ============================== -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/sec_camera" />

        <LinearLayout
            style="@style/Card"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <TextView
                style="@style/StatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_camera" />

            <TextView
                android:id="@+id/camera_value"
                style="@style/MonoData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/camera_closed" />
        </LinearLayout>

        <!-- ============================== record ============================== -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/sec_record" />

        <LinearLayout
            style="@style/Card"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <TextView
                style="@style/StatusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_status" />

            <TextView
                android:id="@+id/record_value"
                style="@style/MonoData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/recording_off" />
        </LinearLayout>

        <!-- ============================== addresses =========================== -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/sec_addresses" />

        <LinearLayout
            style="@style/Card"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/urls"
                style="@style/MonoData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_address" />
        </LinearLayout>

        <!-- ============================== connect ============================= -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/sec_connect" />

        <LinearLayout
            android:id="@+id/card_connect"
            style="@style/Card"
            android:layout_marginBottom="24dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/qr"
                android:layout_width="192dp"
                android:layout_height="192dp"
                android:background="@android:color/white"
                android:contentDescription="@string/qr_content_desc"
                android:padding="8dp" />
        </LinearLayout>

        <!-- ============================== preview ============================= -->
        <TextView
            style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/sec_preview" />

        <FrameLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginBottom="24dp"
            android:padding="0dp">

            <SurfaceView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/preview_hint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/preview_hint"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- ============================== actions ============================= -->
        <Button
            android:id="@+id/btn_record"
            style="@style/BtnOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/start_recording" />

        <Button
            android:id="@+id/btn_server"
            style="@style/BtnPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/start_server" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_settings"
                style="@style/BtnOutline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btn_refresh"
                style="@style/BtnOutline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/refresh" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>