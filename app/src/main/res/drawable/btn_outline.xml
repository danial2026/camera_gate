<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary/outlined selector: 1px border, faint fill when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/bg_btn_disabled" />
    <item android:state_pressed="true" android:drawable="@drawable/bg_btn_outline_pressed" />
    <item android:drawable="@drawable/bg_btn_outline" />
</selector>