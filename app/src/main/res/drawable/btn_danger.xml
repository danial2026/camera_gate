<?xml version="1.0" encoding="utf-8"?>
<!-- Destructive selector: red idle, darker pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:drawable="@drawable/bg_btn_disabled" />
    <item android:state_pressed="true" android:drawable="@drawable/bg_btn_danger_pressed" />
    <item android:drawable="@drawable/bg_btn_danger" />
</selector>